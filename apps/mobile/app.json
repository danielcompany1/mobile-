{
  "expo": {
    "name": "DueDay",
    "slug": "dueday",
    "scheme": "dueday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.example.dueday",
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "DueDay can remind you about deadlines you choose to track."
      }
    },
    "android": {
      "package": "com.example.dueday",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": { "foregroundImage": "./assets/icon-foreground.png", "backgroundColor": "#345B43" }
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#F4F5F0", "image": "./assets/splash-icon.png", "imageWidth": 174, "dark": { "backgroundColor": "#111B15", "image": "./assets/splash-icon-dark.png" } }],
      ["expo-notifications", { "defaultChannel": "deadlines", "color": "#345B43", "icon": "./assets/notification-icon.png" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
