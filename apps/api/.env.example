PORT="4000"
# Comma-separate several origins if needed, e.g. "http://localhost:3000,https://dueday.app"
WEB_ORIGIN="http://localhost:3000"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
SUPABASE_SERVICE_ROLE_KEY="replace_with_server_only_service_role_key"
# Sign-in codes are emailed by the API through Resend.
RESEND_API_KEY="re_replace_me"
# Must be an address on a domain verified in Resend (onboarding@resend.dev only reaches your own Resend inbox).
RESEND_FROM_EMAIL="DueDay <hello@example.com>"
RESEND_REPLY_TO=""
NOTIFICATION_CRON_SECRET="replace_with_a_long_random_secret"
